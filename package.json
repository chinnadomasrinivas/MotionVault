{
  "name": "python-run-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/project-library.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PythonRun out/raw.mp4",
    "mix": "node scripts/loudnorm.mjs out/raw.mp4 out/python-run-final.mp4",
    "build:video": "npm run render && npm run mix",
    "audio": "python scripts/build_audio.py",
    "align": "python scripts/align.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
